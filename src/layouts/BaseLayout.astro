---
import '../styles/global.css';
import type { Locale } from '../i18n/types';
import type { I18n } from '../models';
import Header from '../components/layout/Header.astro';
import PageFooter from '../components/layout/PageFooter.astro';

interface Props {
  title?: string;
  description?: string;
  i18n: I18n;
  locale: Locale;
  currentPage?: 'home' | 'work' | 'about' | 'experience' | 'contact';
  pathSuffix?: string;
}

const {
  title = 'Portfolio',
  description = 'Frontend developer portfolio',
  i18n,
  locale,
  currentPage = 'home',
  pathSuffix,
} = Astro.props;
const base = import.meta.env.BASE_URL;

---

<!doctype html>
<html lang={locale} data-theme="day">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="description" content={description} />

    <link rel="stylesheet" href={`${base}/fonts/manrope/manrope.css`} />
    <link rel="stylesheet" href={`${base}/fonts/dm-mono/dm-mono.css`} />

    <title>{title}</title>

    <script is:inline>
      const themeKey = 'theme';

      const storedTheme = localStorage.getItem(themeKey);

      if (storedTheme === 'day' || storedTheme === 'night') {
        document.documentElement.dataset.theme = storedTheme;
      } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
        document.documentElement.dataset.theme = 'night';
      }
    </script>
  </head>

  <body
    class="flex h-screen flex-col overflow-hidden bg-base-200 text-base-content">
    <Header
      i18n={i18n}
      locale={locale}
      currentPage={currentPage}
      pathSuffix={pathSuffix}
    />
    <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain">
      <main class="p-3 sm:p-5 lg:p-7">
        <slot />
      </main>
      <PageFooter i18n={i18n} locale={locale} />
    </div>
  </body>
</html>
