---
import type { Locale } from '../i18n/types';
import type { I18n } from '../models';
import BaseLayout from '../layouts/BaseLayout.astro';
import { Icon } from 'astro-icon/components';

interface Props {
  i18n: I18n;
  locale: Locale;
  slug: string;
}

const { i18n, locale, slug } = Astro.props;
const work = i18n.pages.work;
const project = work.projects.find(item => item.slug === slug);

if (!project) {
  throw new Error(`Unknown work system: ${slug}`);
}
const base = import.meta.env.BASE_URL;
const workPath = `${base}/${locale}/work`;
const technologyGroups = project.technologies ?? [
  {category: work.detail.technologyStack, items: project.tags.map(name => ({name, description: ''}))},
];
const categoryIcons: Record<string, string> = {
  Framework: 'lucide:layers-3',
  'Interface & visualisation': 'lucide:layout-dashboard',
  'State management': 'lucide:workflow',
  'Application architecture': 'lucide:boxes',
  'Testing & delivery': 'lucide:rocket',
};
---

<BaseLayout
  title={`${project.title} — ${i18n.nav.header.work}`}
  description={project.description}
  i18n={i18n}
  currentPage="work"
  pathSuffix={`/work/${project.slug}`}
  locale={locale}>

    <main
      class="mx-auto max-w-[90rem] px-3 py-5 sm:px-5 sm:py-8 lg:px-6 lg:py-10">
      <a
        href={workPath}
        class="inline-flex items-center gap-2 font-mono text-[0.6875rem] font-medium uppercase tracking-[0.08em] text-base-content/65 transition-colors hover:text-base-content">
         <span aria-hidden="true">←</span>{work.detail.back}
      </a>

      <section class="mt-6 grid gap-8 lg:grid-cols-12 lg:items-end lg:pb-8">
        <div class="lg:col-span-8">
          <p class="typography-eyebrow text-base-content/60">
            {project.eyebrow}
          </p>
          <h1
            class="mt-6 text-balance font-sans text-5xl font-bold leading-[0.86] tracking-[-0.08em] text-base-content sm:text-6xl lg:text-7xl">
            {project.title}
          </h1>
        </div>
        <p
          class="font-mono text-[0.6875rem] font-medium uppercase tracking-[0.1em] text-base-content/55 lg:col-span-4 lg:pb-1">
          {project.client}
        </p>
      </section>

      <article class="system-panel mt-3">
        <div>
          <section>
            <p class="typography-eyebrow text-base-content/60">
              {work.detail.overview}
            </p>
            <p
              class="mt-8 max-w-3xl text-2xl font-medium leading-[1.15] tracking-[-0.04em] text-base-content sm:text-3xl">
              {project.description}
            </p>
            {
              project.details && (
                <p class="mt-6 max-w-3xl text-base leading-7 text-base-content/70">
                  {project.details}
                </p>
              )
            }
          </section>

          <section class="mt-12">
            <p class="typography-eyebrow text-base-content/60">
              {work.detail.technologyStack}
            </p>
            <div class="mt-8 grid gap-8">
              {
                technologyGroups.map(group => (
                  <div class="grid gap-4">
                    <h3 class="flex items-center gap-2 font-mono text-[0.6875rem] font-medium uppercase tracking-[0.08em] text-accent">
                      <Icon
                        name={categoryIcons[group.category] ?? 'lucide:layers-3'}
                        class="size-4"
                        aria-hidden="true"
                      />
                      {group.category}
                    </h3>
                    <div class="grid gap-5 sm:grid-cols-2">
                      {
                        group.items.map(technology => (
                          <div class="flex items-start gap-2">
                            {
                              technology.name === 'Angular' && (
                                <Icon
                                  name="simple-icons:angular"
                                  class="mt-0.5 size-9 shrink-0 text-[#DD0031]"
                                  aria-hidden="true"
                                />
                              )
                            }
                            <div class="grid gap-1">
                              <p class="font-mono text-[0.6875rem] font-medium uppercase tracking-[0.08em] text-base-content">
                                {technology.name}
                              </p>
                              {
                                technology.description && (
                                  <p class="text-sm leading-6 text-base-content/65">
                                    {technology.description}
                                  </p>
                                )
                              }
                            </div>
                          </div>
                        ))
                      }
                    </div>
                  </div>
                ))
              }
            </div>
          </section>

          <section class="mt-12" aria-label={work.detail.gallery}>
            <p class="typography-eyebrow text-base-content/60">
              {work.detail.gallery}
            </p>
            <div class="mt-8 grid gap-3 sm:grid-cols-2">
              <div class="relative aspect-[16/9] overflow-hidden rounded-[1rem] border border-base-300 bg-base-200">
                <div class="absolute inset-x-0 top-1/3 h-px bg-base-300"></div>
                <div class="absolute inset-x-0 top-2/3 h-px bg-base-300"></div>
                <div class="absolute inset-y-0 left-1/3 w-px bg-base-300"></div>
                <div class="absolute inset-y-0 left-2/3 w-px bg-base-300"></div>
                <span class="absolute bottom-3 left-3 font-mono text-[0.5625rem] font-medium uppercase tracking-[0.1em] text-base-content/45">
                  Project image placeholder
                </span>
              </div>
              <div class="relative aspect-[16/9] overflow-hidden rounded-[1rem] border border-base-300 bg-base-200">
                <div class="absolute left-1/2 top-1/2 size-20 -translate-x-1/2 -translate-y-1/2 rounded-full border border-primary/70"></div>
                <div class="absolute inset-x-8 top-1/2 h-px bg-base-300"></div>
                <div class="absolute inset-y-8 left-1/2 w-px bg-base-300"></div>
                <span class="absolute bottom-3 left-3 font-mono text-[0.5625rem] font-medium uppercase tracking-[0.1em] text-base-content/45">
                  Project image placeholder
                </span>
              </div>
            </div>
          </section>
        </div>

        {
          project.brochure?.label && project.brochure.url && (
            <a
              href={`${base}/${project.brochure.url}`}
              target="_blank"
              rel="noreferrer"
              class="mt-8 inline-flex items-center gap-2 font-mono text-[0.6875rem] font-medium uppercase tracking-[0.08em] text-accent underline underline-offset-4 transition-colors hover:text-base-content">
              {project.brochure.label}<span aria-hidden="true">↗</span>
            </a>
          )
        }

        <aside class="mt-8 lg:flex lg:items-start lg:justify-between lg:gap-12">
          <p class="typography-eyebrow text-base-content/60">NDA</p>
          <p class="mt-3 max-w-2xl text-sm leading-6 text-base-content/60 lg:mt-0">
            {work.detail.nda}
          </p>
        </aside>
      </article>
    </main>
</BaseLayout>
