---
import type { Locale } from '../i18n/types';
import type { I18n } from '../models';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  i18n: I18n;
  locale: Locale;
  slug: string;
}

const { i18n, locale, slug } = Astro.props;
const work = i18n.pages.work;
const project = work.projects.find(item => item.slug === slug);

if (!project) {
  throw new Error(`Unknown work system: ${slug}`);
}

const workPath = `/${locale}/work`;
---

<BaseLayout
  title={`${project.title} — ${i18n.nav.header.work}`}
  description={project.description}
  i18n={i18n}
  currentPage="work"
  pathSuffix={`/work/${project.slug}`}
  locale={locale}>

    <main
      class="mx-auto max-w-[90rem] px-3 py-8 sm:px-5 sm:py-12 lg:px-6 lg:py-16">
      <a
        href={workPath}
        class="inline-flex items-center gap-2 font-mono text-[0.6875rem] font-medium uppercase tracking-[0.08em] text-base-content/65 transition-colors hover:text-base-content">
         <span aria-hidden="true">←</span>{work.detail.back}
      </a>

      <section class="mt-10 grid gap-10 lg:grid-cols-12 lg:items-end lg:pb-16">
        <div class="lg:col-span-8">
          <p class="typography-eyebrow text-base-content/60">
            {project.eyebrow}
          </p>
          <h1
            class="mt-6 text-balance font-sans text-5xl font-bold leading-[0.86] tracking-[-0.08em] text-base-content sm:text-6xl lg:text-7xl">
            {project.title}
          </h1>
        </div>
        <p
          class="font-mono text-[0.6875rem] font-medium uppercase tracking-[0.1em] text-base-content/55 lg:col-span-4 lg:pb-1">
          {project.client}
        </p>
      </section>

      <section class="grid gap-3 border-t border-base-300 pt-3 lg:grid-cols-12">
        <article class="system-panel lg:col-span-8">
          <p class="typography-eyebrow text-base-content/60">
             {work.detail.overview}
          </p>
          <p
            class="mt-12 max-w-3xl text-2xl font-medium leading-[1.15] tracking-[-0.04em] text-base-content sm:text-3xl">
            {project.description}
          </p>
        </article>

        <aside class="system-panel lg:col-span-4">
          <p class="typography-eyebrow text-base-content/60">
             {work.detail.signals}
          </p>
          <div class="mt-12 flex flex-wrap gap-2">
            {
              project.tags.map(tag => (
                <span class="rounded-full border border-base-300 px-3 py-1.5 font-mono text-[0.625rem] font-medium uppercase tracking-[0.08em] text-base-content/65">
                  {tag}
                </span>
              ))
            }
          </div>
        </aside>
      </section>

      <aside
        class="mt-10 border-t border-base-300 pt-5 lg:mt-14 lg:flex lg:items-start lg:justify-between lg:gap-12">
        <p class="typography-eyebrow text-base-content/60">NDA</p>
        <p
          class="mt-3 max-w-2xl text-sm leading-6 text-base-content/60 lg:mt-0">
           {work.detail.nda}
        </p>
      </aside>
    </main>
</BaseLayout>
