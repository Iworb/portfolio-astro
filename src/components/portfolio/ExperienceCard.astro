---
import BentoCard from './BentoCard.astro';
import type { HomeI18n } from '../../i18n/types';

interface Props {
  i18n: HomeI18n;
}

const { i18n } = Astro.props;
---

<BentoCard
  class="min-h-36 overflow-hidden bg-primary/8
    lg:col-span-4"
  label={i18n.experience.label}>
  <div class="flex h-full items-center justify-between gap-5">
    <div class="shrink-0">
      <p
        class="text-4xl font-black leading-none tracking-tight text-base-content">
        10+
      </p>
      <p class="mt-3 max-w-24 text-sm font-medium leading-5 text-base-content">
        {i18n.experience.years}
      </p>
    </div>

    <svg
      class="h-16 w-1/2 max-w-36 text-primary"
      viewBox="0 0 140 70"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true">
      <path
        d="M2 62H138"
        stroke="currentColor"
        stroke-opacity=".18"
        stroke-dasharray="2 5"></path>
      <path
        d="M4 55C14 55 14 45 24 45C34 45 34 51 43 51C53 51 55 39 64 39C74 39 73 28 84 28C94 28 93 36 102 36C111 36 116 15 126 15C132 15 134 7 138 3"
        stroke="currentColor"
        stroke-width="2.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
  </div>
</BentoCard>
