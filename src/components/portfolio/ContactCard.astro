---
import BentoCard from './BentoCard.astro';
import type { HomeI18n } from '../../i18n/types';

interface Props {
  i18n: HomeI18n;
}

const { i18n } = Astro.props;
---

<BentoCard
  id="contact"
  class="relative min-h-32 overflow-hidden bg-accent/15
    lg:col-span-3"
  label={i18n.contact.title}>
  <div class="relative z-10 flex h-full flex-col justify-between gap-4">
    <h2 class="max-w-40 text-lg font-bold leading-tight text-base-content">
      {i18n.contact.title}
    </h2>

    <a
      href="#contact"
      class="inline-flex w-fit items-center gap-2 text-xs font-semibold text-base-content transition-opacity hover:opacity-60">
      {i18n.contact.cta}
      <span aria-hidden="true">→</span>
    </a>
  </div>

  <svg
    class="pointer-events-none absolute bottom-3 right-3 size-14 text-accent/50"
    viewBox="0 0 56 56"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true">
    <g fill="currentColor">
      <circle cx="8" cy="8" r="1"></circle><circle cx="20" cy="8" r="1"
      ></circle><circle cx="32" cy="8" r="1"></circle><circle
        cx="44"
        cy="8"
        r="1"></circle>
      <circle cx="8" cy="20" r="1"></circle><circle cx="20" cy="20" r="1"
      ></circle><circle cx="32" cy="20" r="1"></circle><circle
        cx="44"
        cy="20"
        r="1"></circle>
      <circle cx="8" cy="32" r="1"></circle><circle cx="20" cy="32" r="1"
      ></circle><circle cx="32" cy="32" r="1"></circle><circle
        cx="44"
        cy="32"
        r="1"></circle>
      <circle cx="8" cy="44" r="1"></circle><circle cx="20" cy="44" r="1"
      ></circle><circle cx="32" cy="44" r="1"></circle><circle
        cx="44"
        cy="44"
        r="1"></circle>
    </g>
  </svg>
</BentoCard>
