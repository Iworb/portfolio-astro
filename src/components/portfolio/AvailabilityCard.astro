---
import BentoCard from './BentoCard.astro';
import type { HomeI18n } from '../../i18n/types';

interface Props {
  i18n: HomeI18n;
}

const { i18n } = Astro.props;
---

<BentoCard
  class="relative min-h-36 overflow-hidden bg-success/10
    lg:col-span-4"
  label={i18n.availability.label}>
  <div class="relative z-10 flex h-full flex-col justify-between gap-5">
    <div class="flex items-center justify-between gap-3">
      <p class="flex items-center gap-2 text-sm font-semibold text-success">
        <span
          class="size-2 rounded-full bg-success ring-4 ring-success/15"
          aria-hidden="true"></span>
        {i18n.availability.title}
      </p>

      <span
        class="size-2 rounded-full bg-success ring-4 ring-success/15"
        aria-label={i18n.availability.current}></span>
    </div>

    <div class="text-sm leading-5 text-base-content">
      <p>{i18n.availability.schedule}</p>
      <p>{i18n.availability.location}</p>
    </div>

    <svg
      class="pointer-events-none absolute bottom-0 right-0 size-16 text-success/40"
      viewBox="0 0 64 64"
      fill="none"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true">
      <g fill="currentColor">
        <circle cx="8" cy="8" r="1"></circle><circle cx="20" cy="8" r="1"
        ></circle><circle cx="32" cy="8" r="1"></circle><circle
          cx="44"
          cy="8"
          r="1"></circle>
        <circle cx="8" cy="20" r="1"></circle><circle cx="20" cy="20" r="1"
        ></circle><circle cx="32" cy="20" r="1"></circle><circle
          cx="44"
          cy="20"
          r="1"></circle>
        <circle cx="8" cy="32" r="1"></circle><circle cx="20" cy="32" r="1"
        ></circle><circle cx="32" cy="32" r="1"></circle><circle
          cx="44"
          cy="32"
          r="1"></circle>
        <circle cx="8" cy="44" r="1"></circle><circle cx="20" cy="44" r="1"
        ></circle><circle cx="32" cy="44" r="1"></circle><circle
          cx="44"
          cy="44"
          r="1"></circle>
      </g>
    </svg>
  </div>
</BentoCard>
