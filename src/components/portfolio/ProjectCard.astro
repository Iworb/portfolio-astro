---
import BentoCard from './BentoCard.astro';
import type { HomeI18n } from '../../i18n/types';

interface Props {
  i18n: HomeI18n;
}

const { i18n } = Astro.props;
---

<BentoCard
  id="work"
  class="min-h-72 overflow-hidden
    lg:col-span-6 lg:row-span-2"
  label={i18n.project.label}>
  <div class="flex h-full flex-col justify-between gap-8">
    <div>
      <p class="text-xs font-medium text-base-content/60">
        {i18n.project.label}
      </p>
      <h2 class="mt-3 text-lg font-bold tracking-tight text-base-content">
        {i18n.project.title}
      </h2>
    </div>

    <div
      class="flex flex-col gap-6 sm:flex-row sm:items-end sm:justify-between">
      <div class="max-w-xs">
        <p class="text-sm leading-6 text-base-content/70">
          {i18n.project.description}
        </p>

        <a
          href="/work#positron-tracking-system"
          class="mt-5 inline-flex items-center gap-2 text-xs font-semibold text-primary transition-colors hover:text-primary/70">
          {i18n.project.cta}
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <img
        src="https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?auto=format&fit=crop&w=640&q=85"
        alt={i18n.project.imageAlt}
        class="h-28 w-full rounded-lg object-cover sm:h-24 sm:w-44"
        loading="lazy"
        decoding="async"
      />
    </div>
  </div>
</BentoCard>
