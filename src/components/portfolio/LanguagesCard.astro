---
import BentoCard from './BentoCard.astro';
import type { HomeI18n } from '../../i18n/types';

interface Props {
  i18n: HomeI18n;
}

const { i18n } = Astro.props;
---

<BentoCard class="min-h-52
    lg:col-span-4" label={i18n.languages.label}>
  <div class="flex h-full flex-col">
    <h2 class="text-xs font-semibold text-base-content">
      {i18n.languages.label}
    </h2>

    <ul class="mt-5 grid gap-3 text-xs">
      <li class="grid grid-cols-[4.5rem_1fr_auto] items-center gap-2">
        <span class="text-base-content/80">{i18n.languages.items[0].name}</span>
        <span class="flex gap-1" aria-label={i18n.languages.items[0].level}>
          <i class="h-1 flex-1 rounded-full bg-primary"></i><i
            class="h-1 flex-1 rounded-full bg-primary"></i><i
            class="h-1 flex-1 rounded-full bg-primary"></i><i
            class="h-1 flex-1 rounded-full bg-primary"></i><i
            class="h-1 flex-1 rounded-full bg-primary"></i>
        </span>
        <span class="text-base-content/60">{i18n.languages.items[0].level}</span
        >
      </li>
      <li class="grid grid-cols-[4.5rem_1fr_auto] items-center gap-2">
        <span class="text-base-content/80">{i18n.languages.items[1].name}</span>
        <span class="flex gap-1" aria-label={i18n.languages.items[1].level}>
          <i class="h-1 flex-1 rounded-full bg-primary"></i><i
            class="h-1 flex-1 rounded-full bg-primary"></i><i
            class="h-1 flex-1 rounded-full bg-primary"></i><i
            class="h-1 flex-1 rounded-full bg-primary"></i><i
            class="h-1 flex-1 rounded-full bg-primary"></i>
        </span>
        <span class="text-base-content/60">{i18n.languages.items[1].level}</span
        >
      </li>
      <li class="grid grid-cols-[4.5rem_1fr_auto] items-center gap-2">
        <span class="text-base-content/80">{i18n.languages.items[2].name}</span>
        <span class="flex gap-1" aria-label={i18n.languages.items[2].level}>
          <i class="h-1 flex-1 rounded-full bg-primary"></i><i
            class="h-1 flex-1 rounded-full bg-primary"></i><i
            class="h-1 flex-1 rounded-full bg-primary"></i><i
            class="h-1 flex-1 rounded-full bg-primary"></i><i
            class="h-1 flex-1 rounded-full bg-base-300"></i>
        </span>
        <span class="text-base-content/60">{i18n.languages.items[2].level}</span
        >
      </li>
      <li class="grid grid-cols-[4.5rem_1fr_auto] items-center gap-2">
        <span class="text-base-content/80">{i18n.languages.items[3].name}</span>
        <span class="flex gap-1" aria-label={i18n.languages.items[3].level}>
          <i class="h-1 flex-1 rounded-full bg-primary"></i><i
            class="h-1 flex-1 rounded-full bg-primary"></i><i
            class="h-1 flex-1 rounded-full bg-primary"></i><i
            class="h-1 flex-1 rounded-full bg-base-300"></i><i
            class="h-1 flex-1 rounded-full bg-base-300"></i>
        </span>
        <span class="text-base-content/60">{i18n.languages.items[3].level}</span
        >
      </li>
    </ul>
  </div>
</BentoCard>
