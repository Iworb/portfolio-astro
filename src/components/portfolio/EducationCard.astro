---
import BentoCard from './BentoCard.astro';
import type { HomeI18n } from '../../i18n/types';

interface Props {
  i18n: HomeI18n;
}

const { i18n } = Astro.props;
---

<BentoCard
  id="education"
  class="min-h-40
    lg:col-span-4"
  label={i18n.education.label}>
  <div class="flex h-full flex-col gap-4">
    <h2 class="text-xs font-semibold text-base-content">
      {i18n.education.label}
    </h2>
    <div>
      <h3 class="text-xs font-semibold text-base-content">
        {i18n.education.degree}
      </h3>
      <p class="mt-2 text-xs leading-5 text-base-content/70">
        {i18n.education.university}
      </p>
      <p class="mt-1 text-xs text-base-content/60">{i18n.education.period}</p>
    </div>
  </div>
</BentoCard>
