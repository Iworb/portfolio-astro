---
import BentoCard from './BentoCard.astro';
import { Icon } from 'astro-icon/components';
import type { HomeI18n } from '../../i18n/types';

interface Props {
  i18n: HomeI18n;
}

const { i18n } = Astro.props;
const items = i18n.tech.groups.flatMap(group => group.items);
const icons = [
  'lucide:hexagon',
  'lucide:braces',
  'lucide:radio',
  'lucide:layers-3',
  'lucide:blocks',
  'lucide:server',
  'lucide:cloud',
];
---

<BentoCard class="min-h-72 lg:col-span-3 lg:row-span-2" label={i18n.tech.label}>
  <div class="flex h-full flex-col">
    <h2 class="text-xs font-semibold text-base-content">{i18n.tech.label}</h2>

    <ul class="mt-5 grid gap-3 text-xs text-base-content/80">
      {
        items.map((item, index) => (
          <li class="flex items-center gap-3">
            <span class="grid size-5 place-items-center rounded bg-primary/15 text-primary">
              <Icon name={icons[index % icons.length]} class="size-3.5" />
            </span>
            {item}
          </li>
        ))
      }
    </ul>
  </div>
</BentoCard>
