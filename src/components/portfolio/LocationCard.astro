---
import BentoCard from './BentoCard.astro';
import { Icon } from 'astro-icon/components';
import type { HomeI18n } from '../../i18n/types';

interface Props {
  i18n: HomeI18n;
}

const { i18n } = Astro.props;
---

<BentoCard
  class="relative min-h-40 overflow-hidden bg-info/10
    lg:col-span-4"
  label={i18n.location.title}>
  <div class="relative z-10 flex h-full flex-col justify-between gap-4">
    <div class="flex items-center justify-between gap-3">
      <h2 class="text-xs font-semibold text-base-content">
        {i18n.location.title}
      </h2>
      <Icon name="lucide:map-pin" class="size-5 text-info" />
    </div>
    <p class="max-w-48 text-sm leading-5 text-base-content/80">
      {i18n.location.description}
    </p>
  </div>

  <svg
    class="pointer-events-none absolute bottom-3 right-3 size-14 text-info/25"
    viewBox="0 0 56 56"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true">
    <g fill="currentColor">
      <circle cx="8" cy="8" r="1"></circle><circle cx="20" cy="8" r="1"
      ></circle><circle cx="32" cy="8" r="1"></circle><circle
        cx="44"
        cy="8"
        r="1"></circle>
      <circle cx="8" cy="20" r="1"></circle><circle cx="20" cy="20" r="1"
      ></circle><circle cx="32" cy="20" r="1"></circle><circle
        cx="44"
        cy="20"
        r="1"></circle>
      <circle cx="8" cy="32" r="1"></circle><circle cx="20" cy="32" r="1"
      ></circle><circle cx="32" cy="32" r="1"></circle><circle
        cx="44"
        cy="32"
        r="1"></circle>
      <circle cx="8" cy="44" r="1"></circle><circle cx="20" cy="44" r="1"
      ></circle><circle cx="32" cy="44" r="1"></circle><circle
        cx="44"
        cy="44"
        r="1"></circle>
    </g>
  </svg>
</BentoCard>
