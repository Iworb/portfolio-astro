---
import BentoCard from './BentoCard.astro';
import type { HomeI18n } from '../../i18n/types';

interface Props {
  i18n: HomeI18n;
}

const { i18n } = Astro.props;
---

<BentoCard
  id="about"
  class="min-h-56
    lg:col-span-3 lg:row-span-2"
  label={i18n.about.label}>
  <div class="flex h-full flex-col justify-between gap-8">
    <div>
      <p class="text-xs font-semibold text-base-content">{i18n.about.label}</p>
      <p class="mt-5 text-sm leading-6 text-base-content/80">
        {i18n.about.description}
      </p>
    </div>

    <a
      href="/about"
      class="inline-flex w-fit items-center gap-2 text-xs font-semibold text-primary transition-colors hover:text-primary/70">
      {i18n.about.cta}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</BentoCard>
