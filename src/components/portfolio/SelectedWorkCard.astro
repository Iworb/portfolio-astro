---
import BentoCard from './BentoCard.astro';
import type { HomeI18n } from '../../i18n/types';

interface Props {
  i18n: HomeI18n;
}

const { i18n } = Astro.props;
const projects = i18n.selected.projects;
---

<BentoCard
  class="min-h-[30rem] overflow-hidden
    lg:col-span-8 lg:row-span-3"
  label={i18n.selected.label}>
  <div class="flex h-full flex-col">
    <div class="flex items-center justify-between gap-4">
      <h2 class="text-lg font-bold tracking-tight text-base-content">
        {i18n.selected.label}
      </h2>
      <a
        href="#work"
        class="inline-flex items-center gap-2 text-xs font-semibold text-primary transition-colors hover:text-primary/70">
        {i18n.selected.viewAll}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="mt-6 divide-y divide-base-300">
      <article
        class="grid gap-4 py-4 first:pt-0 sm:grid-cols-[1fr_9rem] sm:items-center">
        <div>
          <h3 class="text-sm font-semibold text-base-content">
            {projects[0].title}
          </h3>
          <p class="mt-2 max-w-lg text-xs leading-5 text-base-content/70">
            {projects[0].description}
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            <span
              class="badge badge-sm border-primary/20 bg-primary/5 text-primary"
              >{projects[0].tags[0]}</span
            >
            <span
              class="badge badge-sm border-primary/20 bg-primary/5 text-primary"
              >{projects[0].tags[1]}</span
            >
            <span
              class="badge badge-sm border-primary/20 bg-primary/5 text-primary"
              >{projects[0].tags[2]}</span
            >
            <span
              class="badge badge-sm border-primary/20 bg-primary/5 text-primary"
              >{projects[0].tags[3]}</span
            >
          </div>
        </div>
        <img
          src="https://images.unsplash.com/photo-1513828583688-c52646db42da?auto=format&fit=crop&w=360&q=80"
          alt={projects[0].imageAlt}
          class="h-20 w-full rounded-md object-cover"
          loading="lazy"
          decoding="async"
        />
      </article>

      <article class="grid gap-4 py-4 sm:grid-cols-[1fr_9rem] sm:items-center">
        <div>
          <h3 class="text-sm font-semibold text-base-content">
            {projects[1].title}
          </h3>
          <p class="mt-2 max-w-lg text-xs leading-5 text-base-content/70">
            {projects[1].description}
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            <span
              class="badge badge-sm border-primary/20 bg-primary/5 text-primary"
              >{projects[1].tags[0]}</span
            >
            <span
              class="badge badge-sm border-primary/20 bg-primary/5 text-primary"
              >{projects[1].tags[1]}</span
            >
            <span
              class="badge badge-sm border-primary/20 bg-primary/5 text-primary"
              >{projects[1].tags[2]}</span
            >
          </div>
        </div>
        <img
          src="https://images.unsplash.com/photo-1441986300917-64674bd600d8?auto=format&fit=crop&w=360&q=80"
          alt={projects[1].imageAlt}
          class="h-20 w-full rounded-md object-cover"
          loading="lazy"
          decoding="async"
        />
      </article>

      <article
        class="grid gap-4 py-4 last:pb-0 sm:grid-cols-[1fr_9rem] sm:items-center">
        <div>
          <h3 class="text-sm font-semibold text-base-content">
            {projects[2].title}
          </h3>
          <p class="mt-2 max-w-lg text-xs leading-5 text-base-content/70">
            {projects[2].description}
          </p>
          <div class="mt-3 flex flex-wrap gap-2">
            <span
              class="badge badge-sm border-primary/20 bg-primary/5 text-primary"
              >{projects[2].tags[0]}</span
            >
            <span
              class="badge badge-sm border-primary/20 bg-primary/5 text-primary"
              >{projects[2].tags[1]}</span
            >
            <span
              class="badge badge-sm border-primary/20 bg-primary/5 text-primary"
              >{projects[2].tags[2]}</span
            >
          </div>
        </div>
        <img
          src="https://images.unsplash.com/photo-1581094794329-c8112a89af12?auto=format&fit=crop&w=360&q=80"
          alt={projects[2].imageAlt}
          class="h-20 w-full rounded-md object-cover"
          loading="lazy"
          decoding="async"
        />
      </article>
    </div>
  </div>
</BentoCard>
