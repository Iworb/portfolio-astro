---
import type { HomeI18n, Locale } from '../i18n/types';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './layout/Header.astro';
import PageFooter from './layout/PageFooter.astro';
import WorkProjectCard from './work/WorkProjectCard.astro';

interface Props {
  i18n: HomeI18n;
  locale: Locale;
}

const { i18n, locale } = Astro.props;
const [featured, ...supporting] = i18n.work.projects;
---

<BaseLayout
  title={`${i18n.nav.work} — ${i18n.meta.title}`}
  description={i18n.work.description}
  lang={locale}>
  <Header i18n={i18n} locale={locale} currentPage="work" />

  <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain">
    <main
      class="mx-auto max-w-[90rem] px-3 py-8 sm:px-5 sm:py-12 lg:px-6 lg:py-16">
      <section
        class="grid gap-8 border-b border-base-300 pb-12 lg:grid-cols-12 lg:items-end lg:pb-16">
        <div class="lg:col-span-8">
          <p class="typography-eyebrow text-base-content/60">
            {i18n.work.eyebrow}
          </p>
          <h1
            class="mt-6 max-w-4xl text-balance font-sans text-5xl font-bold leading-[0.86] tracking-[-0.08em] text-base-content sm:text-6xl lg:text-7xl">
            {i18n.work.title}
          </h1>
        </div>
        <div class="lg:col-span-4 lg:pb-1">
          <p
            class="max-w-lg text-pretty text-base leading-7 text-base-content/70">
            {i18n.work.description}
          </p>
          <p
            class="mt-6 font-mono text-[0.6875rem] font-medium uppercase tracking-[0.1em] text-base-content/55">
            {i18n.work.count}
          </p>
        </div>
      </section>

      <section class="mt-3 grid gap-3" aria-label={i18n.work.eyebrow}>
        {
          featured && (
            <WorkProjectCard
              project={featured}
              index={0}
              locale={locale}
              viewLabel={i18n.work.detail.view}
            />
          )
        }
        {
          supporting.map((project, index) => (
            <WorkProjectCard
              project={project}
              index={index + 1}
              locale={locale}
              viewLabel={i18n.work.detail.view}
            />
          ))
        }
      </section>

      <aside
        class="mt-10 border-t border-base-300 pt-5 lg:mt-14 lg:flex lg:items-start lg:justify-between lg:gap-12">
        <p class="typography-eyebrow text-base-content/60">
          NDA-aware selection
        </p>
        <p
          class="mt-3 max-w-2xl text-sm leading-6 text-base-content/60 lg:mt-0">
          {i18n.work.note}
        </p>
      </aside>
    </main>

    <PageFooter i18n={i18n} locale={locale} />
  </div>
</BaseLayout>
