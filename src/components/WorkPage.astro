---
import type { Locale } from '../i18n/types';
import type { I18n } from '../models';
import BaseLayout from '../layouts/BaseLayout.astro';
import WorkProjectCard from './work/WorkProjectCard.astro';

interface Props {
  i18n: I18n;
  locale: Locale;
}

const { i18n, locale } = Astro.props;
const work = i18n.pages.work;
const [featured, ...supporting] = work.projects;
---

<BaseLayout
  title={`${i18n.nav.header.work} — ${i18n.meta.title}`}
  description={work.hero.description}
  i18n={i18n}
  currentPage="work"
  locale={locale}>

    <main
      class="mx-auto max-w-[90rem] px-3 py-8 sm:px-5 sm:py-12 lg:px-6 lg:py-16">
      <section
        class="grid gap-8 pb-12 lg:grid-cols-12 lg:items-end lg:pb-16">
        <div class="lg:col-span-8">
          <p class="typography-eyebrow text-base-content/60">
            {work.hero.eyebrow}
          </p>
          <h1
            class="mt-6 max-w-4xl text-balance font-sans text-5xl font-bold leading-[0.86] tracking-[-0.08em] text-base-content sm:text-6xl lg:text-7xl">
            {work.hero.title}
          </h1>
        </div>
        <div class="lg:col-span-4 lg:pb-1">
          <p
            class="max-w-lg text-pretty text-base leading-7 text-base-content/70">
            {work.hero.description}
          </p>
          <p
            class="mt-6 font-mono text-[0.6875rem] font-medium uppercase tracking-[0.1em] text-base-content/55">
            {work.hero.count}
          </p>
        </div>
      </section>

       <section class="mt-3 min-w-0 grid grid-cols-1 gap-3 lg:grid-cols-2" aria-label={work.hero.eyebrow}>
        {
          featured && (
            <WorkProjectCard
              project={featured}
              locale={locale}
            />
          )
        }
        {
          supporting.map((project, index) => (
            <WorkProjectCard
              project={project}
              locale={locale}
            />
          ))
        }
      </section>

      <aside
        class="mt-10 border-t border-base-300 pt-5 lg:mt-14 lg:flex lg:items-start lg:justify-between lg:gap-12">
        <p class="typography-eyebrow text-base-content/60">
          NDA-aware selection
        </p>
        <p
          class="mt-3 max-w-2xl text-sm leading-6 text-base-content/60 lg:mt-0">
           {work.note}
        </p>
      </aside>
    </main>
</BaseLayout>
