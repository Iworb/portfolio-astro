---
import { Icon } from 'astro-icon/components';
import type { I18n } from '../../models';

interface Props {
  i18n: I18n;
}

const { i18n } = Astro.props;
const skills = i18n.pages.home.skills;
---

<section
  class="home-panel home-skills lg:col-span-7"
  aria-labelledby="skills-title">
  <div class="flex flex-col gap-6">
    <div>
      <p class="typography-eyebrow text-base-content/60">{skills.label}</p>
      <h2
        id="skills-title"
        class="mt-5 max-w-xl text-3xl font-bold leading-[0.92] tracking-[-0.065em] text-base-content">
        {skills.title}
      </h2>
    </div>

    <div class="grid gap-x-6 gap-y-7 sm:grid-cols-2 xl:grid-cols-3">
      {
        skills.groups.map(group => (
          <section class="border-t border-base-300 pt-4">
            <div class="flex items-center gap-2 text-base-content">
              <Icon
                name={group.icon}
                class="size-4 text-primary"
                aria-hidden="true"
              />
              <h3 class="font-mono text-[0.6875rem] font-medium uppercase tracking-[0.08em]">
                {group.label}
              </h3>
            </div>
            <p class="mt-3 text-sm leading-6 text-base-content/70">
              {group.items.join(' · ')}
            </p>
          </section>
        ))
      }
    </div>
  </div>
</section>
