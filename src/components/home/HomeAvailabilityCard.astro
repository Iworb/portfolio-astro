---
import type { I18n } from '../../models';

interface Props {
  i18n: I18n;
}

const { i18n } = Astro.props;
const availability = i18n.pages.home.availability;
---

<aside
  class="home-panel home-availability lg:col-span-4"
   aria-label={availability.label}>
  <div class="flex h-full flex-col justify-between gap-12">
    <div class="flex items-center justify-between gap-3">
      <p class="typography-eyebrow text-[color:#171B15]/70">
        {availability.label}
      </p>
      <span
        class="flex size-3 items-center justify-center rounded-full bg-[color:#171B15]"
        aria-label={availability.current}>
        <span class="size-1.5 rounded-full bg-primary"></span>
      </span>
    </div>

    <div>
      <h2
        class="max-w-sm text-4xl font-bold leading-[0.9] tracking-[-0.07em] text-[color:#171B15]">
        {availability.title}
      </h2>
      <p class="mt-5 max-w-xs text-sm leading-6 text-[color:#171B15]/75">
        {availability.schedule}<br />{availability.location}
      </p>
    </div>

    <p
      class="font-mono text-[0.625rem] font-medium uppercase tracking-[0.12em] text-[color:#171B15]/70">
       {availability.note}
    </p>
  </div>
</aside>
