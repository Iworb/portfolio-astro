---
import type { HomeI18n, Locale } from '../../i18n/types';

interface Props {
  i18n: HomeI18n;
  locale: Locale;
}

const { i18n, locale } = Astro.props;
---

<section
  class="home-panel home-hero lg:col-span-8"
  aria-labelledby="home-title">
  <div
    class="relative z-10 flex h-full max-w-3xl flex-col justify-between gap-12">
    <div>
      <p class="typography-eyebrow text-base-content/60">{i18n.hero.label}</p>
      <h1
        id="home-title"
        class="mt-5 max-w-3xl text-balance font-sans text-5xl font-bold leading-[0.86] tracking-[-0.08em] text-base-content sm:text-6xl lg:text-7xl">
        {i18n.hero.title}
      </h1>
      <p
        class="mt-6 max-w-xl text-pretty text-base leading-7 text-base-content/70 sm:text-lg">
        {i18n.hero.description}
      </p>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row">
      <a
        href={i18n.hero.cvLink}
        download
        class="btn btn-primary min-h-11 rounded-[0.625rem] px-5 font-semibold">
        {i18n.hero.downloadCv}<span aria-hidden="true">↓</span>
      </a>
      <a
        href={`/${locale}/contact`}
        class="btn btn-outline min-h-11 rounded-[0.625rem] px-5 font-semibold">
        {i18n.contact.cta}<span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>

  <div
    class="pointer-events-none absolute inset-y-0 right-0 hidden w-[38%] overflow-hidden lg:block"
    aria-hidden="true">
    <div class="absolute inset-y-0 left-0 w-px bg-base-300"></div>
    <div
      class="absolute -right-8 top-12 size-56 rounded-full border border-base-300">
    </div>
    <div
      class="absolute right-11 top-20 size-28 rounded-full border border-primary/80">
    </div>
    <div class="absolute bottom-0 left-8 h-[45%] w-px bg-base-300"></div>
    <div class="absolute bottom-14 left-8 right-0 h-px bg-base-300"></div>
    <span
      class="absolute bottom-18 left-12 font-mono text-[0.625rem] tracking-[0.14em] text-base-content/45"
      >SYSTEM / CLARITY</span
    >
  </div>
</section>
