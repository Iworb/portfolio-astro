---
import type { Locale } from '../../i18n/types';
import type { I18n } from '../../models';

interface Props {
  i18n: I18n;
  locale: Locale;
}

const { i18n, locale } = Astro.props;
const approach = i18n.pages.home.approach;
const base = import.meta.env.BASE_URL;

---

<section
  id="about"
  class="home-panel lg:col-span-5"
  aria-labelledby="approach-title">
  <div class="flex h-full flex-col justify-between gap-8">
    <div>
       <p class="typography-eyebrow text-base-content/60">{approach.label}</p>
      <h2
        id="approach-title"
        class="mt-5 max-w-2xl text-3xl font-bold leading-[0.96] tracking-[-0.06em] text-base-content sm:text-4xl">
         {approach.title}
      </h2>
      <p
        class="mt-6 max-w-xl text-sm leading-6 text-base-content/70 sm:text-base">
         {approach.description}
      </p>
    </div>
    <a
      href={`${base}/${locale}/contact`}
      class="btn btn-outline group min-h-11 justify-between rounded-[10px] border-base-content px-4 text-sm font-normal text-base-content hover:border-base-content hover:bg-base-content hover:text-base-100">
       {approach.cta}<span
        class="transition-transform group-hover:translate-x-1 motion-reduce:transition-none"
        >↗</span
      >
    </a>
  </div>
</section>
