---
import type { I18n } from '../../models';

interface Props {
  i18n: I18n;
}

const { i18n } = Astro.props;
const resume = i18n.pages.home.resume;
---

<section
  id="experience"
  class="home-panel home-resume lg:col-span-4"
  aria-labelledby="resume-title">
   <p class="typography-eyebrow text-[color:#171B15]/65">{resume.label}</p>
  <div class="mt-10 flex h-[calc(100%-3rem)] flex-col justify-between gap-8">
    <div>
      <p
        class="text-6xl font-bold leading-none tracking-[-0.09em] text-[color:#171B15]">
         {resume.years}
      </p>
      <h2
        id="resume-title"
        class="mt-3 text-2xl font-bold leading-[0.94] tracking-[-0.065em] text-[color:#171B15]">
        {resume.details}.
      </h2>
    </div>
    <a
       href={i18n.pages.home.hero.cvLink}
      download
      class="btn btn-neutral min-h-11 w-fit rounded-[10px] px-4 text-sm font-normal">
       {resume.download} <span aria-hidden="true">↓</span>
    </a>
  </div>
</section>
