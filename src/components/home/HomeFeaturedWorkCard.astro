---
import type { HomeI18n, Locale } from '../../i18n/types';

interface Props {
  i18n: HomeI18n;
  locale: Locale;
}

const { i18n, locale } = Astro.props;
const featured = i18n.selected.projects[0];
const tags = featured.tags;
---

<section
  id="work"
  class="home-panel group min-h-80 lg:col-span-8"
  aria-labelledby="featured-work-title">
  <div class="flex items-start justify-between gap-5">
    <p class="typography-eyebrow text-base-content/60">{i18n.selected.label}</p>
    <a
      href={`/${locale}/work`}
      class="font-mono text-[0.6875rem] font-medium uppercase tracking-[0.08em] text-base-content transition-opacity hover:opacity-60">
      {i18n.selected.viewAll} →
    </a>
  </div>

  <div class="mt-12 grid gap-8 lg:grid-cols-[minmax(0,1fr)_10rem] lg:items-end">
    <div>
      <p
        class="font-mono text-[0.625rem] font-medium uppercase tracking-[0.12em] text-base-content/50">
        Selected system / 01
      </p>
      <h2
        id="featured-work-title"
        class="mt-4 max-w-xl text-4xl font-bold leading-[0.9] tracking-[-0.07em] text-base-content sm:text-5xl">
        {featured.title}
      </h2>
      <p
        class="mt-5 max-w-xl text-sm leading-6 text-base-content/70 sm:text-base">
        {featured.description}
      </p>
      <div class="mt-7 flex flex-wrap gap-2">
        {
          tags.map(tag => (
            <span class="rounded-full border border-base-300 px-3 py-1 font-mono text-[0.625rem] font-medium uppercase tracking-[0.08em] text-base-content/65">
              {tag}
            </span>
          ))
        }
      </div>
    </div>

    <div
      class="relative hidden aspect-square overflow-hidden rounded-[1rem] border border-base-300 bg-base-200 lg:block"
      aria-hidden="true">
      <div class="absolute inset-x-0 top-[33%] h-px bg-base-300"></div>
      <div class="absolute inset-x-0 top-[66%] h-px bg-base-300"></div>
      <div class="absolute inset-y-0 left-[33%] w-px bg-base-300"></div>
      <div class="absolute inset-y-0 left-[66%] w-px bg-base-300"></div>
      <div
        class="absolute left-[33%] top-[33%] size-1/3 rounded-full border border-primary">
      </div>
    </div>
  </div>
</section>
