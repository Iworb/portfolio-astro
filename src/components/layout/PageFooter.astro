---
import { Icon } from 'astro-icon/components';
import CurrentYear from '../islands/CurrentYear';
import type { Locale } from '../../i18n/types';
import type { I18n } from '../../models';

interface Props {
  i18n: I18n;
  locale: Locale;
}

const { i18n, locale } = Astro.props;
---

<footer class="border-t border-base-300 bg-base-100 px-4 py-6 sm:px-6 lg:px-7">
  <div
    class="mx-auto flex max-w-7xl flex-col gap-6
      sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-4">
      <a
        href={`/${locale}`}
        class="text-xl font-black tracking-tight text-base-content"
        aria-label={i18n.meta.title}>
        {i18n.nav.footer.nameShort}
      </a>

      <div class="text-xs leading-5 text-base-content/60">
        <p>© <CurrentYear client:load /> {i18n.nav.footer.copyright}</p>
        <p>{i18n.nav.footer.rights}</p>
      </div>
    </div>

    <nav aria-label={i18n.nav.footer.social}>
      <ul
        class="flex flex-wrap items-center gap-5 text-xs font-medium text-base-content">
        <li>
          <a
            href="https://github.com/iworb"
            class="inline-flex items-center gap-2 transition-colors hover:text-primary"
            target="_blank"
            rel="noreferrer">
            GitHub
            <Icon name="lucide:github" class="size-4" />
          </a>
        </li>
        <li>
          <a
            href="https://www.linkedin.com/in/oleksandr-koshevierov/"
            class="inline-flex items-center gap-2 transition-colors hover:text-primary"
            target="_blank"
            rel="noreferrer">
            LinkedIn
            <Icon name="lucide:linkedin" class="size-4" />
          </a>
        </li>
        <li>
          <a
            href="mailto:iworb.ne@gmail.com"
            class="inline-flex items-center gap-2 transition-colors hover:text-primary">
            Email
            <Icon name="lucide:mail" class="size-4" />
          </a>
        </li>
      </ul>
    </nav>
  </div>
</footer>
