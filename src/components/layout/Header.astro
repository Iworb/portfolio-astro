---
import { Icon } from 'astro-icon/components';
import DesktopNavigation from './DesktopNavigation.astro';
import ThemeSwitcher from '../islands/ThemeSwitcher';
import LanguageSwitcher from '../islands/LanguageSwitcher';
import MobileNavigation from './MobileNavigation.astro';
import type { HomeI18n, Locale } from '../../i18n/types';

interface Props {
  i18n: HomeI18n;
  locale: Locale;
}

const { i18n: copy, locale } = Astro.props;
---

<header
  class="sticky top-0 z-50 shrink-0 border-b border-base-300 bg-base-100/90 backdrop-blur">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="navbar min-h-16 px-0">
      <!-- Mobile menu button -->
      <div class="navbar-start md:hidden">
        <label
          for="mobile-navigation"
          class="btn btn-square btn-ghost"
          aria-label={copy.mobile.open}>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </label>
      </div>

      <!-- Logo -->
      <div class="navbar-center md:navbar-start">
        <a
          href={`/${locale}`}
          class="text-xl font-black tracking-tight"
          aria-label={copy.meta.title}>
          OK
        </a>
      </div>

      <!-- Desktop navigation -->
      <DesktopNavigation i18n={copy} />

      <!-- Controls -->
      <div class="navbar-end gap-1">
        <ThemeSwitcher client:load>
          <Icon slot="sun" name="lucide:sun" class="size-5 fill-current" />
          <Icon slot="moon" name="lucide:moon" class="size-5 fill-current" />
        </ThemeSwitcher>

        <LanguageSwitcher client:load locale={locale} labels={copy.language}>
          <Icon slot="chevron" name="lucide:chevron-down" class="size-4" />
        </LanguageSwitcher>
      </div>
    </div>
  </div>
</header>
<MobileNavigation i18n={copy} locale={locale} />
