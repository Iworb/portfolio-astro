---
import { Icon } from 'astro-icon/components';
import DesktopNavigation from './DesktopNavigation.astro';
import ThemeSwitcher from '../islands/ThemeSwitcher';
import LanguageSwitcher from '../islands/LanguageSwitcher';
import MobileNavigation from './MobileNavigation.astro';
import type { Locale } from '../../i18n/types';
import type {I18n} from "../../models";

interface Props {
  i18n: I18n;
  locale: Locale;
  currentPage?: 'home' | 'work' | 'about' | 'experience' | 'contact';
  pathSuffix?: string;
}

const { i18n, locale, currentPage = 'home', pathSuffix } = Astro.props;
const languagePath =
  pathSuffix ??
  (currentPage === 'work'
    ? '/work'
    : currentPage === 'about'
      ? '/about'
      : currentPage === 'experience'
        ? '/experience'
        : currentPage === 'contact'
          ? '/contact'
          : '');
---

<header
  class="sticky top-0 z-50 shrink-0 border-b border-base-300 bg-base-200/95 backdrop-blur-sm">
  <div
    class="mx-auto flex h-18 max-w-[90rem] items-center gap-3 px-3 sm:px-5 lg:px-6">
    <div class="flex flex-1 items-center lg:flex-none">
      <div class="lg:hidden">
        <label
          for="mobile-navigation"
          class="inline-flex size-10 cursor-pointer items-center justify-center rounded-full border border-base-300 bg-base-100 text-base-content transition-colors hover:border-base-content/60"
          aria-label={i18n.nav.header.aria.open}>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="size-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
        </label>
      </div>

      <a
        href={`/${locale}`}
        class="ml-3 font-sans text-[1.05rem] font-extrabold tracking-[-0.06em] text-base-content lg:ml-0"
        aria-label={i18n.meta.title}>
        {i18n.nav.header.name}
      </a>
    </div>

    <DesktopNavigation i18n={i18n} locale={locale} currentPage={currentPage} />

    <div class="flex flex-1 items-center justify-end gap-2 lg:flex-none">
      <LanguageSwitcher
        client:load
        locale={locale}
        i18n={i18n}
        pathSuffix={languagePath}>
        <Icon slot="chevron" name="lucide:chevron-down" class="size-3.5" />
      </LanguageSwitcher>

      <ThemeSwitcher client:load>
        <Icon slot="sun" name="lucide:sun" class="size-4" />
        <Icon slot="moon" name="lucide:moon" class="size-4" />
      </ThemeSwitcher>
    </div>
  </div>
</header>
<MobileNavigation i18n={i18n} locale={locale} />
