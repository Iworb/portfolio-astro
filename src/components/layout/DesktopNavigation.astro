---
import type { HomeI18n, Locale } from '../../i18n/types';

interface Props {
  i18n: HomeI18n;
  locale: Locale;
  currentPage?: 'home' | 'work' | 'about' | 'experience' | 'contact';
}

const { i18n: copy, locale, currentPage = 'home' } = Astro.props;
const home = `/${locale}`;
---

<nav class="hidden flex-1 justify-center lg:flex" aria-label={copy.nav.work}>
  <ul class="flex items-center gap-1">
    <li>
      <a
        href={`${home}/work`}
        class:list={['nav-link', currentPage === 'work' && 'nav-link-active']}
        >{copy.nav.work}</a
      >
    </li>
    <li>
      <a
        href={`${home}/experience`}
        class:list={[
          'nav-link',
          currentPage === 'experience' && 'nav-link-active',
        ]}>{copy.nav.experience}</a
      >
    </li>
    <li>
      <a
        href={`${home}/about`}
        class:list={['nav-link', currentPage === 'about' && 'nav-link-active']}
        >{copy.nav.about}</a
      >
    </li>
    <li>
      <a
        href={`${home}/contact`}
        class:list={[
          'nav-link',
          currentPage === 'contact' && 'nav-link-active',
        ]}>{copy.nav.contact}</a
      >
    </li>
  </ul>
</nav>
