---
import type {Locale} from '../../i18n/types';
import type {I18n} from "../../models";

interface Props {
  i18n: I18n;
  locale: Locale;
  currentPage?: 'home' | 'work' | 'about' | 'experience' | 'contact';
}

const {i18n, locale, currentPage = 'home'} = Astro.props;
const home = `/${locale}`;
---

<nav class="hidden flex-1 justify-center lg:flex" aria-label={i18n.nav.header.work}>
  <ul class="flex items-center gap-1">
    <li>
      <a
        href={`${home}/work`}
        class:list={['nav-link', currentPage === 'work' && 'nav-link-active']}
      >{i18n.nav.header.work}</a
      >
    </li>
    <li>
      <a
        href={`${home}/experience`}
        class:list={[
          'nav-link',
          currentPage === 'experience' && 'nav-link-active',
        ]}>{i18n.nav.header.experience}</a
      >
    </li>
    <li>
      <a
        href={`${home}/about`}
        class:list={['nav-link', currentPage === 'about' && 'nav-link-active']}
      >{i18n.nav.header.about}</a
      >
    </li>
    <li>
      <a
        href={`${home}/contact`}
        class:list={[
          'nav-link',
          currentPage === 'contact' && 'nav-link-active',
        ]}>{i18n.nav.header.contact}</a
      >
    </li>
  </ul>
</nav>
