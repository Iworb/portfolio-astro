---
import type { Locale } from '../../i18n/types';
import type {I18n} from "../../models";

interface Props {
  i18n: I18n;
  locale: Locale;
}

const { i18n, locale } = Astro.props;
const base = import.meta.env.BASE_URL;

---

<div class="drawer drawer-end md:hidden">
  <input id="mobile-navigation" type="checkbox" class="drawer-toggle" />
  <div class="drawer-content"></div>

  <div class="drawer-side z-[60]">
    <label
      for="mobile-navigation"
      aria-label={i18n.nav.header.aria.close}
      class="drawer-overlay"></label>

    <aside class="min-h-full w-80 max-w-[85vw] bg-base-100 p-5">
      <div class="mb-8 flex items-center justify-between">
        <a
          href={`${base}/${locale}`}
          class="font-sans text-lg font-extrabold tracking-[-0.06em]"
          aria-label={i18n.meta.title}>{i18n.nav.header.name}</a
        >
        <label
          for="mobile-navigation"
          class="btn btn-square btn-ghost"
          aria-label={i18n.nav.header.aria.close}>
          <span class="text-xl" aria-hidden="true">×</span>
        </label>
      </div>

      <nav aria-label={i18n.nav.header.work}>
        <ul class="menu w-full gap-2 p-0">
          <li>
            <a href={`${base}/${locale}/work`} class="min-h-12 rounded-xl text-base"
              >{i18n.nav.header.work}</a
            >
          </li>
          <li>
            <a
              href={`${base}/${locale}/experience`}
              class="min-h-12 rounded-xl text-base">{i18n.nav.header.experience}</a
            >
          </li>
          <li>
            <a href={`${base}/${locale}/about`} class="min-h-12 rounded-xl text-base"
              >{i18n.nav.header.about}</a
            >
          </li>
          <li>
            <a href={`${base}/${locale}/contact`} class="min-h-12 rounded-xl text-base"
              >{i18n.nav.header.contact}</a
            >
          </li>
        </ul>
      </nav>

      <div class="mt-8 border-t border-base-300 pt-6">
        <p class="mb-3 text-sm text-base-content/60">{i18n.nav.header.available}</p>
        <a href={`${base}/${locale}/contact`} class="btn btn-primary w-full"
          >{i18n.nav.header.cta}</a
        >
      </div>
    </aside>
  </div>
</div>
