---
import type { HomeI18n, Locale } from '../i18n/types';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './layout/Header.astro';
import PageFooter from './layout/PageFooter.astro';

interface Props {
  i18n: HomeI18n;
  locale: Locale;
}
const { i18n, locale } = Astro.props;
const experience = i18n.experiencePage;
---

<BaseLayout
  title={`${i18n.nav.experience} — ${i18n.meta.title}`}
  description={experience.description}
  lang={locale}>
  <Header
    i18n={i18n}
    locale={locale}
    currentPage="experience"
    pathSuffix="/experience"
  />
  <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain">
    <main
      class="mx-auto max-w-[90rem] px-3 py-8 sm:px-5 sm:py-12 lg:px-6 lg:py-16">
      <section
        class="grid gap-8 border-b border-base-300 pb-12 lg:grid-cols-12 lg:items-end lg:pb-16">
        <div class="lg:col-span-8">
          <p class="typography-eyebrow text-base-content/60">
            {experience.eyebrow}
          </p>
          <h1
            class="mt-6 max-w-4xl text-balance font-sans text-5xl font-bold leading-[0.86] tracking-[-0.08em] text-base-content sm:text-6xl lg:text-7xl">
            {experience.title}
          </h1>
        </div>
        <p
          class="max-w-lg text-pretty text-base leading-7 text-base-content/70 lg:col-span-4 lg:pb-1">
          {experience.description}
        </p>
      </section>

      <section class="experience-practice mt-3 lg:p-10">
        <p class="typography-eyebrow text-[color:#171B15]/70">
          Continuous practice
        </p>
        <p
          class="mt-10 max-w-4xl text-2xl font-medium leading-[1.18] tracking-[-0.045em] text-[color:#171B15] sm:text-3xl">
          {experience.practice}
        </p>
      </section>

      <section
        class="mt-3 grid gap-3 lg:grid-cols-2"
        aria-label={experience.eyebrow}>
        {
          experience.areas.map((area, index) => (
            <article class="experience-area lg:p-10">
              <>
                <p class="font-mono text-[0.6875rem] font-medium uppercase tracking-[0.1em] text-primary">
                  {String(index + 1).padStart(2, '0')}
                </p>
                <h2 class="mt-10 text-3xl font-bold leading-[0.92] tracking-[-0.065em] text-base-content">
                  {area.title}
                </h2>
                <p class="mt-5 max-w-xl text-sm leading-6 text-base-content/70 sm:text-base">
                  {area.description}
                </p>
              </>
            </article>
          ))
        }
      </section>

      <section class="mt-3 grid gap-3 lg:grid-cols-12">
        <article class="experience-area lg:col-span-8 lg:p-10">
          <p class="typography-eyebrow text-base-content/60">
            Technical posture
          </p><p
            class="mt-10 max-w-3xl text-2xl font-medium leading-[1.18] tracking-[-0.045em] text-base-content sm:text-3xl">
            {experience.posture}
          </p>
        </article>
        <aside class="experience-area lg:col-span-4 lg:p-10">
          <p class="typography-eyebrow text-base-content/60">
            Full chronology
          </p><p class="mt-10 text-sm leading-6 text-base-content/70">
            {experience.cv}
          </p><a
            href={i18n.hero.cvLink}
            download
            class="mt-8 inline-flex min-h-11 items-center gap-2 rounded-[0.625rem] border border-base-300 px-4 font-mono text-[0.6875rem] font-medium uppercase tracking-[0.08em] text-base-content transition-colors hover:border-base-content hover:bg-base-content hover:text-base-100"
            >{i18n.hero.downloadCv}<span aria-hidden="true">↓</span></a>
        </aside>
      </section>
    </main>
    <PageFooter i18n={i18n} locale={locale} />
  </div>
</BaseLayout>
