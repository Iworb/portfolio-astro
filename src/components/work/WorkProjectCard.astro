---
import type { Locale, WorkProjectI18n } from '../../i18n/types';

interface Props {
  project: WorkProjectI18n;
  locale: Locale;
}

const { project, locale } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<a
  href={`${base}/${locale}/work/${project.slug}`}
  class:list={[
    'work-card group relative flex min-w-0 w-full aspect-[16/9] flex-col overflow-hidden no-underline transition-[border-color,background-color] duration-200 hover:border-base-content/50',
    project.featured && 'work-card-featured',
  ]}
  aria-labelledby={`work-${project.slug}-title`}>
  <div
    class="pointer-events-none absolute inset-0 z-0 bg-base-200 opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"
    aria-hidden="true">
    <div class="absolute inset-x-0 top-1/3 h-px bg-base-300"></div>
    <div class="absolute inset-x-0 top-2/3 h-px bg-base-300"></div>
    <div class="absolute inset-y-0 left-1/3 w-px bg-base-300"></div>
    <div class="absolute inset-y-0 left-2/3 w-px bg-base-300"></div>
    <div class="absolute left-1/2 top-1/2 size-24 -translate-x-1/2 -translate-y-1/2 rounded-full border border-primary/80"></div>
  </div>

  <div class="relative z-10 flex items-start justify-between gap-5">
    <p class="typography-eyebrow text-base-content/60">{project.eyebrow}</p>
    <span
      class="font-mono text-[0.625rem] font-medium uppercase tracking-[0.1em] text-base-content/50"
      >{project.client}</span
    >
  </div>

  <div class="relative z-10 mt-14 min-w-0">
    <div>
      <h2
        id={`work-${project.slug}-title`}
        class="mt-4 text-4xl font-bold leading-[0.9] tracking-[-0.07em] text-base-content sm:text-5xl">
        {project.title}
      </h2>
      <p
        class="mt-5 max-w-2xl text-sm leading-6 text-base-content/70 sm:text-base">
        {project.description}
      </p>
    </div>

  </div>

  <div class="relative z-10 mt-auto flex flex-wrap gap-2 pt-10">
      {
        project.tags.map(tag => (
          <span class="rounded-full border border-base-300 px-3 py-1 font-mono text-[0.625rem] font-medium uppercase tracking-[0.08em] text-base-content/65">
            {tag}
          </span>
        ))
      }
  </div>
</a>
