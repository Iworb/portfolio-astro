---
import type { Locale, WorkProjectI18n } from '../../i18n/types';

interface Props {
  project: WorkProjectI18n;
  index: number;
  locale: Locale;
  viewLabel: string;
}

const { project, index, locale, viewLabel } = Astro.props;
---

<article class:list={['work-card', project.featured && 'work-card-featured']}>
  <div class="flex items-start justify-between gap-5">
    <p class="typography-eyebrow text-base-content/60">{project.eyebrow}</p>
    <span
      class="font-mono text-[0.625rem] font-medium uppercase tracking-[0.1em] text-base-content/50"
      >{project.client}</span
    >
  </div>

  <div class="mt-14 grid gap-8 lg:grid-cols-[minmax(0,1fr)_12rem] lg:items-end">
    <div>
      <p
        class="font-mono text-[0.625rem] font-medium uppercase tracking-[0.1em] text-primary">
        System / {String(index + 1).padStart(2, '0')}
      </p>
      <h2
        class="mt-4 text-4xl font-bold leading-[0.9] tracking-[-0.07em] text-base-content sm:text-5xl">
        {project.title}
      </h2>
      <p
        class="mt-5 max-w-2xl text-sm leading-6 text-base-content/70 sm:text-base">
        {project.description}
      </p>
    </div>

    <div class="flex flex-wrap gap-2 lg:justify-end">
      {
        project.tags.map(tag => (
          <span class="rounded-full border border-base-300 px-3 py-1 font-mono text-[0.625rem] font-medium uppercase tracking-[0.08em] text-base-content/65">
            {tag}
          </span>
        ))
      }
    </div>
  </div>

  <a
    href={`/${locale}/work/${project.slug}`}
    class="mt-8 inline-flex min-h-11 items-center gap-2 rounded-[0.625rem] border border-base-300 px-4 font-mono text-[0.6875rem] font-medium uppercase tracking-[0.08em] text-base-content transition-colors hover:border-base-content hover:bg-base-content hover:text-base-100">
    {viewLabel}
    <span aria-hidden="true">↗</span>
  </a>
</article>
