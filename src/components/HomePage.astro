---
import type { HomeI18n, Locale } from '../i18n/types';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from './layout/Header.astro';
import PageFooter from './layout/PageFooter.astro';
import HomeApproachCard from './home/HomeApproachCard.astro';
import HomeAvailabilityCard from './home/HomeAvailabilityCard.astro';
import HomeFeaturedWorkCard from './home/HomeFeaturedWorkCard.astro';
import HomeHeroCard from './home/HomeHeroCard.astro';
import HomeResumeCard from './home/HomeResumeCard.astro';
import HomeSkillsCard from './home/HomeSkillsCard.astro';

interface Props {
  i18n: HomeI18n;
  locale: Locale;
}

const { i18n, locale } = Astro.props;
---

<BaseLayout
  title={i18n.meta.title}
  description={i18n.meta.description}
  lang={locale}>
  <Header i18n={i18n} locale={locale} />

  <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain">
    <main
      class="home-grid mx-auto max-w-[90rem] px-3 py-3 sm:px-5 sm:py-5 lg:px-6">
      <HomeHeroCard i18n={i18n} />
      <HomeAvailabilityCard i18n={i18n} />
      <HomeFeaturedWorkCard i18n={i18n} locale={locale} />
      <HomeSkillsCard i18n={i18n} />
      <HomeResumeCard i18n={i18n} />
      <HomeApproachCard i18n={i18n} />
    </main>

    <PageFooter i18n={i18n} locale={locale} />
  </div>
</BaseLayout>
