---
import type { Locale } from '../i18n/types';
import HomeApproachCard from './home/HomeApproachCard.astro';
import HomeAvailabilityCard from './home/HomeAvailabilityCard.astro';
import HomeFeaturedWorkCard from './home/HomeFeaturedWorkCard.astro';
import HomeHeroCard from './home/HomeHeroCard.astro';
import HomeResumeCard from './home/HomeResumeCard.astro';
import HomeSkillsCard from './home/HomeSkillsCard.astro';
import type { I18n } from '../models';
import BaseLayout from '../layouts/BaseLayout.astro';

interface Props {
  i18n: I18n;
  locale: Locale;
}

const { i18n, locale } = Astro.props;
---
<BaseLayout title={i18n.meta.title} description={i18n.meta.description} i18n={i18n} locale={locale}>
  <div class="home-grid mx-auto max-w-[90rem]">
    <HomeHeroCard i18n={i18n} locale={locale} />
    <HomeAvailabilityCard i18n={i18n} />
    <HomeResumeCard i18n={i18n} />
    <HomeFeaturedWorkCard i18n={i18n} locale={locale} />
    <HomeSkillsCard i18n={i18n} />
    <HomeApproachCard i18n={i18n} />
  </div>
</BaseLayout>
