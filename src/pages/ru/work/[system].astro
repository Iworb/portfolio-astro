---
import SystemPage from '../../../components/SystemPage.astro';
import { ru } from '../../../i18n/ru';

export function getStaticPaths() {
  return ru.work.projects.map(project => ({
    params: { system: project.slug },
  }));
}

const { system } = Astro.params;
---

<SystemPage i18n={ru} locale="ru" slug={system!} />
